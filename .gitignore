# Dados gerados em tempo de execução: token e PIN (config.json), filas, históricos,
# continuação das conversas do Ollama e logs
data/*
!data/.gitkeep
# Logs de instalações antigas que ainda estão na raiz.
/server.log
/server.old.log

# Imagens geradas por npm run imagens
/test-output/

# Dependências do frontend moderno do AI Workspace (apenas dist/ compilado é servido na VPS)
workspace-app/node_modules/
workspace-desktop/target/
